# PostgreSQL (Render Cloud Platform in production)
DATABASE_URL=postgresql://user:password@localhost:5432/broker_db

# Redis (caching layer - FR-07)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-string

# Telegram Bot (FR-04 - instant order/receipt alerts to admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Cloudflare R2 (receipt screenshots + product photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=broker-uploads
# r2.dev dev subdomain, or your connected custom domain — no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

PORT=3001
